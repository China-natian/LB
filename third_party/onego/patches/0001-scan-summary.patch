diff -ruN upstream/pkg/summary.go build-src/pkg/summary.go
--- upstream/pkg/summary.go	1970-01-01 08:00:00
+++ build-src/pkg/summary.go	2026-11-06 15:12:55
@@ -0,0 +1,229 @@
+package pkg
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+const ScanSummarySchema = "onego.scan-summary.v1"
+
+// ScanTargetSummary is the machine-readable coverage record for one target.
+// Tested counts unique numeric ports that reached a scan outcome; open_ports
+// lists only ports confirmed open. Closed, filtered, error and unknown are
+// distinct: only closed is evidence that a port is not listening. The per-state
+// port lists let callers audit and selectively re-check an outcome without
+// rescanning the whole scope.
+type ScanTargetSummary struct {
+	Tested        int            `json:"tested"`
+	Open          int            `json:"open"`
+	Closed        int            `json:"closed"`
+	Filtered      int            `json:"filtered"`
+	Error         int            `json:"error"`
+	Unknown       int            `json:"unknown"`
+	Excluded      int            `json:"excluded"`
+	OpenPorts     []string       `json:"open_ports"`
+	ClosedPorts   []string       `json:"closed_ports"`
+	FilteredPorts []string       `json:"filtered_ports"`
+	ErrorPorts    []string       `json:"error_ports"`
+	UnknownPorts  []string       `json:"unknown_ports"`
+	Special       map[string]int `json:"special,omitempty"`
+
+	ports map[string]string
+}
+
+type ScanSummary struct {
+	Schema     string                        `json:"schema"`
+	StartedAt  string                        `json:"started_at"`
+	FinishedAt string                        `json:"finished_at,omitempty"`
+	Targets    map[string]*ScanTargetSummary `json:"targets"`
+}
+
+var (
+	summaryMu     sync.Mutex
+	activeSummary *ScanSummary
+)
+
+func ResetScanSummary() {
+	summaryMu.Lock()
+	defer summaryMu.Unlock()
+	activeSummary = &ScanSummary{
+		Schema:    ScanSummarySchema,
+		StartedAt: time.Now().UTC().Format(time.RFC3339),
+		Targets:   map[string]*ScanTargetSummary{},
+	}
+}
+
+func summary() *ScanSummary {
+	if activeSummary == nil {
+		activeSummary = &ScanSummary{
+			Schema:    ScanSummarySchema,
+			StartedAt: time.Now().UTC().Format(time.RFC3339),
+			Targets:   map[string]*ScanTargetSummary{},
+		}
+	}
+	return activeSummary
+}
+
+// RecordScanResult is called once per dispatched target:port after the scan
+// outcome is known. It is intentionally cheap and lock-protected because
+// Dispatch runs concurrently.
+func RecordScanResult(result *Result) {
+	if result == nil {
+		return
+	}
+	target := result.Ip
+	if target == "" {
+		target = "unknown"
+	}
+	summaryMu.Lock()
+	defer summaryMu.Unlock()
+	record := summary().Targets[target]
+	if record == nil {
+		record = &ScanTargetSummary{ports: map[string]string{}, Special: map[string]int{}}
+		summary().Targets[target] = record
+	}
+	if result.Excluded {
+		record.Excluded++
+		return
+	}
+	port := strings.TrimSpace(result.Port)
+	number, err := strconv.Atoi(port)
+	if err != nil || number < 1 || number > 65535 {
+		if port != "" {
+			record.Special[port]++
+		}
+		return
+	}
+	state := classifyResult(result)
+	if previous, ok := record.ports[port]; !ok || stateRank(state) > stateRank(previous) {
+		record.ports[port] = state
+	}
+}
+
+func stateRank(state string) int {
+	switch state {
+	case "open":
+		return 4
+	case "closed":
+		return 3
+	case "filtered":
+		return 2
+	case "error":
+		return 1
+	default:
+		return 0
+	}
+}
+
+func classifyResult(result *Result) string {
+	if result.Open {
+		return "open"
+	}
+	message := strings.ToLower(result.Error)
+	switch {
+	case strings.Contains(message, "refused"):
+		return "closed"
+	case strings.Contains(message, "timeout"), strings.Contains(message, "deadline exceeded"):
+		return "filtered"
+	case strings.Contains(message, "permission denied"),
+		strings.Contains(message, "no route"),
+		strings.Contains(message, "unreachable"),
+		strings.Contains(message, "host is down"),
+		strings.Contains(message, "no such host"):
+		return "error"
+	}
+	switch result.ErrStat {
+	case 1:
+		return "closed"
+	case 2:
+		return "filtered"
+	case 3, 4, 5, 6:
+		return "error"
+	}
+	return "unknown"
+}
+
+// WriteScanSummary writes the collected summary atomically. A missing file is
+// safer than a fabricated "complete" claim, so callers must treat write errors
+// as unknown coverage.
+func WriteScanSummary(path string) error {
+	if strings.TrimSpace(path) == "" {
+		return nil
+	}
+	summaryMu.Lock()
+	snapshot := summary()
+	for _, record := range snapshot.Targets {
+		finalize(record)
+	}
+	payload, err := json.MarshalIndent(snapshot, "", "  ")
+	summaryMu.Unlock()
+	if err != nil {
+		return err
+	}
+	directory := filepath.Dir(path)
+	if directory != "" && directory != "." {
+		if err := os.MkdirAll(directory, 0o755); err != nil {
+			return err
+		}
+	}
+	temporary := path + ".tmp"
+	if err := os.WriteFile(temporary, append(payload, '\n'), 0o644); err != nil {
+		return err
+	}
+	return os.Rename(temporary, path)
+}
+
+func finalize(record *ScanTargetSummary) {
+	record.Tested = len(record.ports)
+	record.Open = 0
+	record.Closed = 0
+	record.Filtered = 0
+	record.Error = 0
+	record.Unknown = 0
+	record.OpenPorts = record.OpenPorts[:0]
+	record.ClosedPorts = record.ClosedPorts[:0]
+	record.FilteredPorts = record.FilteredPorts[:0]
+	record.ErrorPorts = record.ErrorPorts[:0]
+	record.UnknownPorts = record.UnknownPorts[:0]
+	for port, state := range record.ports {
+		switch state {
+		case "open":
+			record.Open++
+			record.OpenPorts = append(record.OpenPorts, port)
+		case "closed":
+			record.Closed++
+			record.ClosedPorts = append(record.ClosedPorts, port)
+		case "filtered":
+			record.Filtered++
+			record.FilteredPorts = append(record.FilteredPorts, port)
+		case "error":
+			record.Error++
+			record.ErrorPorts = append(record.ErrorPorts, port)
+		default:
+			record.Unknown++
+			record.UnknownPorts = append(record.UnknownPorts, port)
+		}
+	}
+	sortPorts(record.OpenPorts)
+	sortPorts(record.ClosedPorts)
+	sortPorts(record.FilteredPorts)
+	sortPorts(record.ErrorPorts)
+	sortPorts(record.UnknownPorts)
+	if len(record.Special) == 0 {
+		record.Special = nil
+	}
+}
+
+func sortPorts(ports []string) {
+	sort.Slice(ports, func(i, j int) bool {
+		left, _ := strconv.Atoi(ports[i])
+		right, _ := strconv.Atoi(ports[j])
+		return left < right
+	})
+}
diff -ruN upstream/pkg/summary_test.go build-src/pkg/summary_test.go
--- upstream/pkg/summary_test.go	1970-01-01 08:00:00
+++ build-src/pkg/summary_test.go	2026-11-06 16:19:57
@@ -0,0 +1,161 @@
+package pkg
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/chainreactors/utils/parsers"
+)
+
+func scanResult(ip, port string) *Result {
+	return &Result{GOGOResult: &parsers.GOGOResult{Ip: ip, Port: port}}
+}
+
+func TestScanSummaryClassification(t *testing.T) {
+	ResetScanSummary()
+	open := scanResult("10.0.0.1", "22")
+	open.Open = true
+	refused := scanResult("10.0.0.1", "80")
+	refused.Error = "connect: connection refused"
+	timeout := scanResult("10.0.0.1", "443")
+	timeout.Error = "i/o timeout"
+	denied := scanResult("10.0.0.1", "3306")
+	denied.Error = "permission denied"
+	unknown := scanResult("10.0.0.1", "8080")
+	special := scanResult("10.0.0.1", "snmp")
+	special.Open = true
+	excluded := scanResult("10.0.0.2", "")
+	excluded.Excluded = true
+
+	for _, result := range []*Result{open, refused, timeout, denied, unknown, special, excluded} {
+		RecordScanResult(result)
+	}
+
+	path := filepath.Join(t.TempDir(), "summary.json")
+	if err := WriteScanSummary(path); err != nil {
+		t.Fatalf("write summary: %v", err)
+	}
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read summary: %v", err)
+	}
+	var summary ScanSummary
+	if err := json.Unmarshal(payload, &summary); err != nil {
+		t.Fatalf("decode summary: %v", err)
+	}
+	if summary.Schema != ScanSummarySchema {
+		t.Fatalf("schema = %q, want %q", summary.Schema, ScanSummarySchema)
+	}
+	first := summary.Targets["10.0.0.1"]
+	if first == nil {
+		t.Fatal("missing target 10.0.0.1")
+	}
+	if first.Tested != 5 {
+		t.Errorf("tested = %d, want 5", first.Tested)
+	}
+	if first.Open != 1 || first.Closed != 1 || first.Filtered != 1 || first.Error != 1 || first.Unknown != 1 {
+		t.Errorf("unexpected counts: %+v", first)
+	}
+	if len(first.OpenPorts) != 1 || first.OpenPorts[0] != "22" {
+		t.Errorf("open ports = %v, want [22]", first.OpenPorts)
+	}
+	if first.Special["snmp"] != 1 {
+		t.Errorf("special = %v, want snmp:1", first.Special)
+	}
+	second := summary.Targets["10.0.0.2"]
+	if second == nil || second.Excluded != 1 || second.Tested != 0 {
+		t.Fatalf("unexpected excluded target: %+v", second)
+	}
+}
+
+func TestScanSummaryDeduplicatesPorts(t *testing.T) {
+	ResetScanSummary()
+	refused := scanResult("10.0.0.1", "22")
+	refused.Error = "connection refused"
+	open := scanResult("10.0.0.1", "22")
+	open.Open = true
+	RecordScanResult(refused)
+	RecordScanResult(open)
+	RecordScanResult(refused)
+
+	path := filepath.Join(t.TempDir(), "summary.json")
+	if err := WriteScanSummary(path); err != nil {
+		t.Fatalf("write summary: %v", err)
+	}
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read summary: %v", err)
+	}
+	var summary ScanSummary
+	if err := json.Unmarshal(payload, &summary); err != nil {
+		t.Fatalf("decode summary: %v", err)
+	}
+	record := summary.Targets["10.0.0.1"]
+	if record.Tested != 1 {
+		t.Errorf("tested = %d, want 1", record.Tested)
+	}
+	if record.Open != 1 || record.Closed != 0 {
+		t.Errorf("open/closed = %d/%d, want 1/0", record.Open, record.Closed)
+	}
+}
+
+func TestScanSummaryListsPerStatePorts(t *testing.T) {
+	ResetScanSummary()
+	open := scanResult("10.0.0.1", "443")
+	open.Open = true
+	refusedHigh := scanResult("10.0.0.1", "8080")
+	refusedHigh.Error = "connection refused"
+	refusedLow := scanResult("10.0.0.1", "80")
+	refusedLow.Error = "connection refused"
+	timeout := scanResult("10.0.0.1", "22")
+	timeout.Error = "i/o timeout"
+	denied := scanResult("10.0.0.1", "2375")
+	denied.Error = "permission denied"
+	unknown := scanResult("10.0.0.1", "9000")
+	for _, result := range []*Result{open, refusedHigh, refusedLow, timeout, denied, unknown} {
+		RecordScanResult(result)
+	}
+
+	path := filepath.Join(t.TempDir(), "summary.json")
+	if err := WriteScanSummary(path); err != nil {
+		t.Fatalf("write summary: %v", err)
+	}
+	payload, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read summary: %v", err)
+	}
+	var summary ScanSummary
+	if err := json.Unmarshal(payload, &summary); err != nil {
+		t.Fatalf("decode summary: %v", err)
+	}
+	record := summary.Targets["10.0.0.1"]
+	if record == nil {
+		t.Fatal("missing target 10.0.0.1")
+	}
+	for _, test := range []struct {
+		name string
+		got  []string
+		want []string
+	}{
+		{"open", record.OpenPorts, []string{"443"}},
+		{"closed", record.ClosedPorts, []string{"80", "8080"}},
+		{"filtered", record.FilteredPorts, []string{"22"}},
+		{"error", record.ErrorPorts, []string{"2375"}},
+		{"unknown", record.UnknownPorts, []string{"9000"}},
+	} {
+		if !reflect.DeepEqual(test.got, test.want) {
+			t.Errorf("%s ports = %v, want %v", test.name, test.got, test.want)
+		}
+	}
+}
+
+func TestScanSummaryIgnoresNilResult(t *testing.T) {
+	ResetScanSummary()
+	RecordScanResult(nil)
+	if got := len(summary().Targets); got != 0 {
+		t.Fatalf("targets = %d, want 0", got)
+	}
+}
